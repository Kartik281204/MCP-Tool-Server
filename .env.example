# Copy to .env and adjust as needed. All variables are prefixed MCP_ and
# are optional -- see app/config/settings.py for defaults.

MCP_APP_NAME=mcp-tool-server
MCP_APP_VERSION=0.1.0

# development | staging | production
MCP_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
MCP_LOG_LEVEL=INFO

# stdio | http | sse
# Use "stdio" when a client (e.g. Claude Desktop) spawns this process
# directly. Use "http" to run it as a standalone network service (this is
# what the Docker deployment expects).
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Comma-separated bearer tokens required to call MCP tools over http.
# Empty (the default) disables auth entirely -- deliberately open out of
# the box for local exploration. Set this before exposing the server
# anywhere it isn't fully trusted. /health is never gated by this.
MCP_API_KEYS=

# FastMCP itself pings PyPI on startup to check for a newer release (shown
# in the startup banner). Harmless locally; in production this is an
# unnecessary network dependency at boot, so it's usually turned off there.
# stable | prerelease | off
FASTMCP_CHECK_FOR_UPDATES=stable
